<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowSplashScreenBackground">@color/phytosense_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/phytosense_boot_badge</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenAnimationDuration">350</item>
        <item name="android:statusBarColor">@color/phytosense_launch_background</item>
        <item name="android:navigationBarColor">@color/phytosense_launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
